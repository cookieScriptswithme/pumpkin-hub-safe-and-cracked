local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- Variáveis do primeiro script (Física/Tracker)
local v1 = nil
local v2 = nil
local v3 = nil
local v4 = 0
local v5 = false
local v6 = true
local v7 = 0

-- Configurações do segundo script (Vôo/Pulo na água sem resetar speed)
local WATER_JUMP_FORCE = 167 -- quanto maior, mais alto o pulo

---------------------------------------------------------
-- SISTEMA ANTI-MOEDA (MM2)
---------------------------------------------------------

local function handleAntiCoin(object)
    pcall(function()
        -- Verifica se o objeto é uma moeda do MM2 por nome ou estrutura comum
        if object.Name == "Coin" or object.Name == "CoinContainer" or object:FindFirstChild("CoinVisual") then
            -- Desativa a capacidade de toque localmente para não coletar
            if object:IsA("BasePart") then
                object.CanTouch = false
            end
            for _, child in ipairs(object:GetDescendants()) do
                if child:IsA("BasePart") then
                    child.CanTouch = false
                end
            end
        end
    end)
end

-- Inicializa a varredura de moedas existentes e novas de forma isolada
task.spawn(function()
    pcall(function()
        -- Verifica o que já está no mapa
        for _, desc in ipairs(Workspace:GetDescendants()) do
            handleAntiCoin(desc)
        end
        
        -- Escuta novas moedas que surgirem durante a partida
        Workspace.DescendantAdded:Connect(function(desc)
            handleAntiCoin(desc)
        end)
    end)
end)

---------------------------------------------------------
-- FUNÇÕES DO SISTEMA DE FÍSICA / TRACKER
---------------------------------------------------------

local function getAveragePosition(p1)
    local sum = Vector3.new(0, 0, 0)
    local count = 0

    for _, v in ipairs(p1:GetDescendants()) do
        if v:IsA("BasePart") and not v.Anchored and v.Name ~= "TrackerPart" and not v:FindFirstAncestorOfClass("Tool") then
            sum += v.Position
            count += 1
        end
    end

    if count == 0 then
        return v2.Position
    end

    return sum / count
end

local function zeroOutCharacterMass()
    if not v1 then return end
    for _, v in ipairs(v1:GetDescendants()) do
        if v:IsA("BasePart") and v ~= v3 and not v:FindFirstAncestorOfClass("Tool") then
            v.CustomPhysicalProperties = PhysicalProperties.new(0.2, 0.3, 0.5, 1, 1)
        end
    end
end

local function waitForMass(part)
    local count = 0
    while part.AssemblyMass < 0.01 and count < 40 do
        task.wait(0.1)
        count += 1
    end
    return part.AssemblyMass
end

local function updateTracker()
    if not v6 or not v1 or not v2 then
        return
    end

    if not v3 or not v3.Parent then
        local TrackerPart = Instance.new("Part")
        TrackerPart.Name = "TrackerPart"
        TrackerPart.Size = Vector3.new(2, 2, 2)
        TrackerPart.Transparency = 1
        TrackerPart.CanCollide = false
        TrackerPart.Anchored = false
        TrackerPart.Parent = v1

        local WeldConstraint = Instance.new("WeldConstraint")
        WeldConstraint.Part0 = TrackerPart
        WeldConstraint.Part1 = v2
        WeldConstraint.Parent = TrackerPart

        v3 = TrackerPart
    end

    local avgPos = getAveragePosition(v1)
    v3.Position = avgPos + (avgPos - v2.Position) * 0.35

    zeroOutCharacterMass()

    local volume = v3.Size.X * v3.Size.Y * v3.Size.Z
    v3.CustomPhysicalProperties = PhysicalProperties.new(
        math.clamp((volume > 0 and v4 / volume or 1), 0.1, 35),
        0.3,
        0.5,
        1,
        1
    )
end

local function safeUpdate()
    if not v6 then
        return
    end

    local now = tick()
    if now - v7 < 0.2 then
        return
    end

    v7 = now
    task.defer(updateTracker)
end

---------------------------------------------------------
-- FUNÇÃO PRINCIPAL DE INICIALIZAÇÃO DO PERSONAGEM
---------------------------------------------------------

local function onCharacter(character)
    v1 = character

    if v3 then
        pcall(function() v3:Destroy() end)
        v3 = nil
    end

    local humanoid = character:WaitForChild("Humanoid", 5)
    local root = character:WaitForChild("HumanoidRootPart", 5)
    
    if not humanoid or not root then return end
    
    local swimming = false

    -- Detecta se está nadando e impede o jogo de resetar sua velocidade
    local stateConnection
    stateConnection = humanoid.StateChanged:Connect(function(old, new)
        if not character.Parent then 
            if stateConnection then stateConnection:Disconnect() end
            return 
        end
        
        if new == Enum.HumanoidStateType.Swimming then
            swimming = true
        else
            swimming = false
        end

        if old == Enum.HumanoidStateType.Swimming and new == Enum.HumanoidStateType.Jumping then
            pcall(function()
                humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
            end)
        end
    end)

    -- Detecta quando você aperta pulo (Aplica força mantendo a velocidade horizontal)
    local jumpConnection
    jumpConnection = UserInputService.JumpRequest:Connect(function()
        if not character.Parent then 
            if jumpConnection then jumpConnection:Disconnect() end
            return 
        end
        
        -- O pcall aqui garante que, se você abrir o chat ou menu enquanto pula, o script não quebre
        pcall(function()
            if swimming and root then
                root.AssemblyLinearVelocity = Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    WATER_JUMP_FORCE,
                    root.AssemblyLinearVelocity.Z
                )
            end
        end)
    end)

    -- --- Continuação da configuração do Script 1 ---
    task.delay(1, function()
        if not v1 or v1 ~= character then
            return
        end

        v2 = root
        v5 = true
        v4 = waitForMass(v2)

        pcall(updateTracker)

        character.DescendantAdded:Connect(function(obj)
            if not obj:FindFirstAncestorOfClass("Tool") then
                safeUpdate()
            end
        end)

        character.DescendantRemoving:Connect(function(obj)
            if not obj:FindFirstAncestorOfClass("Tool") then
                safeUpdate()
            end
        end)
    end)
end

-- Conexões seguras para executar ao entrar e ao renascer
LocalPlayer.CharacterAdded:Connect(function(char)
    pcall(onCharacter, char)
end)

if LocalPlayer.Character then
    task.spawn(function()
        pcall(onCharacter, LocalPlayer.Character)
    end)
end
